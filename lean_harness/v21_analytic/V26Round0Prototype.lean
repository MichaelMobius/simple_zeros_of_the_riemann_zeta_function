/-- Kernel-checked exact completion of squares for the first discarded word. -/
theorem v26_R0_111114_completion (x0 x1 x2 x3 x4 x5 : ℝ) :
    v26R0Q111114 x0 x1 x2 x3 x4 x5 =
      v26R0Qmin111114 + v26R0SOS111114 x0 x1 x2 x3 x4 x5 := by
  unfold v26R0Q111114 v26R0Qmin111114 v26R0SOS111114
  ring

/-- The completed-square remainder is nonnegative. -/
theorem v26_R0_111114_sos_nonneg (x0 x1 x2 x3 x4 x5 : ℝ) :
    0 ≤ v26R0SOS111114 x0 x1 x2 x3 x4 x5 := by
  unfold v26R0SOS111114
  positivity

/-- Exact global lower bound for the rational quadratic certificate. -/
theorem v26_R0_111114_qmin_le (x0 x1 x2 x3 x4 x5 : ℝ) :
    v26R0Qmin111114 ≤ v26R0Q111114 x0 x1 x2 x3 x4 x5 := by
  rw [v26_R0_111114_completion]
  exact le_add_of_nonneg_right (v26_R0_111114_sos_nonneg x0 x1 x2 x3 x4 x5)

/-- The exact minimum clears the six-gap target by a strict rational margin. -/
theorem v26_R0_111114_qmin_gt_delta :
    v26Delta < v26R0Qmin111114 := by
  norm_num [v26Delta, v26R0Qmin111114]

/-- Consequently the rational quadratic attached to `111114` is everywhere
strictly above the target. -/
theorem v26_R0_111114_discard (x0 x1 x2 x3 x4 x5 : ℝ) :
    v26Delta < v26R0Q111114 x0 x1 x2 x3 x4 x5 :=
  v26_R0_111114_qmin_gt_delta.trans_le
    (v26_R0_111114_qmin_le x0 x1 x2 x3 x4 x5)

end HurtadoZeta23
